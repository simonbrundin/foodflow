# ==================================================================
# Foodflow Development Environment
#
version_settings(constraint='>=0.22.2')

update_settings(suppress_unused_image_warnings=['pgadmin'])

# ==================================================================
# Helpers
# ==================================================================

# Require tool helper
def require_tool(tool, msg=None):
    tool = shlex.quote(tool)
    if not msg:
        msg = '%s is required but was not found in PATH' % tool
    local(
        command='command -v %s >/dev/null 2>&1 || { echo >&2 "%s"; exit 1; }' % (tool, msg),
        quiet=True,
    )

# ==================================================================
# Configuration
# ==================================================================

# Detect Kind context
current_context = str(k8s_context()).lower()
is_kind = 'kind' in current_context and 'foodflow' in current_context

if is_kind:
    # =================================================================
    # Kind Mode
    # =================================================================

    allow_k8s_contexts('kind-foodflow')

    # Get registry host
    registry_host = str(local(
        'ctlptl get cluster kind-foodflow -o template ' +
        '--template "{{.status.localRegistryHosting.host}}" 2>/dev/null || echo "localhost:5001"'
    )).strip()
    if not registry_host:
        registry_host = 'localhost:5001'

    default_registry(registry_host)

    # Build Nuxt dev image
    docker_build(
        'foodflow-dev',
        context = '../../src/nuxt',
        dockerfile = '../../src/nuxt/Dockerfile.dev',
        only = [
            'app', 'server', 'pages', 'components', 'composables', 'utils',
            'nuxt.config.ts', 'package.json', 'pnpm-lock.yaml', 'pnpm-workspace.yaml',
        ],
        live_update = [
            fall_back_on('../../src/nuxt/nuxt.config.ts'),
            fall_back_on('../../src/nuxt/package.json'),
            sync('../../src/nuxt/app', '/app/app'),
            sync('../../src/nuxt/server', '/app/server'),
            sync('../../src/nuxt/pages', '/app/pages'),
            sync('../../src/nuxt/components', '/app/components'),
            sync('../../src/nuxt/composables', '/app/composables'),
            sync('../../src/nuxt/utils', '/app/utils'),
            run('bun install', trigger=['../../src/nuxt/package.json', '../../src/nuxt/pnpm-lock.yaml']),
        ],
    )

    # Build pgAdmin image
    docker_build(
        'pgadmin',
        context = '.',
        dockerfile = './pgadmin.Dockerfile',
    )

    # Deploy to Kubernetes
    k8s_yaml(kustomize('.'))

    # Resource configuration
    k8s_resource(
        workload='foodflow-app',
        port_forwards='3500:3000',
        labels=['frontend'],
    )
    k8s_resource(
        workload='foodflow-api',
        port_forwards='3501:8080',
        labels=['backend'],
    )
    k8s_resource(
        workload='foodflow-pgadmin',
        port_forwards='3502:80',
        labels=['database'],
    )

    # ChartDB - database diagram editor
    k8s_resource(
        workload='foodflow-chartdb',
        port_forwards='3504:80',
        labels=['tools'],
    )

    # PostgreSQL for Kind mode
    k8s_resource(
        workload='foodflow-db',
        port_forwards='5433:5432',
        labels=['database'],
    )

    if config.tilt_subcommand == 'up':
        print("""
\033[32mKind mode enabled\033[0m
Registry: {registry}

Access:
  Nuxt:    http://localhost:3500
  API:     http://localhost:3501
  pgAdmin: http://localhost:30002
            Username: admin@pg.app
            Password: admin@pg.app
  ChartDB: http://localhost:3504
        """.format(registry=registry_host))

else:
    # =================================================================
    # Local Docker Mode
    # =================================================================

    local_resource(
        "network",
        cmd = ["sh", "-c", "docker network create foodflow-net 2>/dev/null || true"],
        labels = ['setup'],
        auto_init = True,
    )

    # PostgreSQL
    local_resource(
        "postgres",
        cmd = ["sh", "-c", """
            docker rm -f foodflow-dev-postgres 2>/dev/null || true
            docker run -d --name foodflow-dev-postgres --network foodflow-net \\
                -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=foodflow \\
                postgres:16-alpine
            for i in $(seq 1 30); do
                docker exec foodflow-dev-postgres pg_isready -U postgres && break
                sleep 1
            done
            docker exec foodflow-dev-postgres psql -U postgres -c 'DROP DATABASE IF EXISTS foodflow;' 2>/dev/null || true
            docker exec foodflow-dev-postgres psql -U postgres -c 'CREATE DATABASE foodflow;'
            docker exec -i foodflow-dev-postgres psql -U postgres -d foodflow < /home/simon/repos/foodflow/environments/dev/db/schema.sql
        """],
        labels = ['database'],
        resource_deps = ['network'],
        auto_init = True,
    )

    # pg-view
    local_resource(
        "pgview",
        cmd = ["sh", "-c", """
            docker rm -f pgview 2>/dev/null || true
            docker run -d --name pgview --network foodflow-net -p 3503:3000 \\
                -e DB_URL=postgresql://postgres:postgres@foodflow-dev-postgres:5432/foodflow \\
                lcurrol/pg-view
        """],
        labels = ['database'],
        resource_deps = ['postgres'],
        auto_init = True,
    )

    # pgAdmin
    local_resource(
        "pgadmin",
        cmd = ["sh", "-c", """
            docker rm -f pgadmin 2>/dev/null || true
            docker run -d --name pgadmin --network foodflow-net -p 3502:80 \\
                -e PGADMIN_DEFAULT_EMAIL=admin@pg.app -e PGADMIN_DEFAULT_PASSWORD=admin@pg.app \\
                -v pgadmin_data:/var/lib/pgadmin \\
                -v /home/simon/repos/foodflow/environments/dev/pgadmin-servers.json:/pgadmin4/servers.json:ro \\
                dpage/pgadmin4:latest
        """],
        labels = ['database'],
        resource_deps = ['postgres'],
        auto_init = True,
    )

    # schema-server
    local_resource(
        "schema-server",
        cmd = ["sh", "-c", """
            python3 /home/simon/repos/foodflow/environments/dev/scripts/gen-view.py
            docker rm -f schema-server 2>/dev/null || true
            docker run -d --name schema-server --network foodflow-net -p 8080:80 \\
                -v /home/simon/repos/foodflow/environments/dev/db:/usr/share/nginx/html:ro nginx:alpine
        """],
        labels = ['tools'],
        auto_init = True,
    )

    # ChartDB
    local_resource(
        "chartdb",
        cmd = ["sh", "-c", """
            docker rm -f chartdb 2>/dev/null || true
            docker run -d --name chartdb --network foodflow-net -p 3504:80 ghcr.io/chartdb/chartdb:latest
        """],
        labels = ['tools'],
        auto_init = True,
    )

    # Nuxt dev server
    local_resource(
        "Nuxt",
        cmd = ["sh", "-c",
            "set -a; . /home/simon/repos/foodflow/environments/dev/.env; set +a; " +
            "docker rm -f foodflow-nuxt 2>/dev/null || true; " +
            "docker run -d --name foodflow-nuxt --network foodflow-net -p 3500:3000 " +
            "-v /home/simon/repos/foodflow/src/nuxt:/app -w /app " +
            "-e PGHOST=foodflow-dev-postgres -e PGPORT=5432 -e PGDATABASE=foodflow " +
            "-e PGUSER=postgres -e PGPASSWORD=postgres " +
            "-e HOST=0.0.0.0 -e PORT=3000 " +
            "oven/bun:1 bun dev --port 3000 --host 0.0.0.0"
        ],
        labels = ['frontend'],
        resource_deps = ['postgres'],
        auto_init = True,
    )

    if config.tilt_subcommand == 'up':
        print("""
\033[32mLocal Docker mode enabled\033[0m

Access:
  Nuxt:    http://localhost:3500
  API:     http://localhost:3501
  pgAdmin: http://localhost:3502
            Username: admin@pg.app
            Password: admin@pg.app
  pg-view: http://localhost:3503
  ChartDB: http://localhost:3504
  Schema:  http://localhost:8080
        """)

# ==================================================================
# Local overrides (optional)
# Add settings to local.tiltfile to override without committing
# ==================================================================
if os.path.exists('local.tiltfile'):
    load_dynamic('local.tiltfile')
